<Window x:Class="SessionFinder.Wpf.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="660"
        Height="780"
        MinWidth="520"
        MinHeight="440"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        UseLayoutRounding="True">

  <!--
    Windows 11's settings layout: grouped cards of rows, the label on the left and the control on
    the right, toggles for anything that is on or off, and the explanation as a caption under its
    card. The controls are the Fluent theme's own.
  -->
  <Window.Resources>
    <Style x:Key="RowStyle" TargetType="Grid">
      <Setter Property="Margin" Value="16,8" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style x:Key="FieldStyle" TargetType="TextBox" BasedOn="{StaticResource SettingsTextBoxStyle}">
      <Setter Property="Width" Value="260" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="NumberStyle" TargetType="TextBox" BasedOn="{StaticResource SettingsTextBoxStyle}">
      <Setter Property="Width" Value="100" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="PathStyle" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CardCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
      <Setter Property="Margin" Value="4,8,4,0" />
    </Style>
    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GroupTitleStyle}">
      <Setter Property="Margin" Value="2,20,2,8" />
    </Style>
    <Style x:Key="RowSeparatorStyle" TargetType="Border" BasedOn="{StaticResource SeparatorStyle}">
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" Style="{StaticResource OverlayScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,4,24,24">

        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Shell" />
        <Border Style="{StaticResource GroupStyle}">
          <StackPanel>
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Hotkey" />
              <TextBox Grid.Column="1" Style="{StaticResource FieldStyle}" Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Start at login" />
              <CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBoxStyle}" IsChecked="{Binding StartAtLogin}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Hide the search box when it loses focus" />
              <CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBoxStyle}" IsChecked="{Binding HideOnDeactivate}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Verbose logging" />
              <CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBoxStyle}" IsChecked="{Binding VerboseLogging}" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource CardCaptionStyle}">
          <Run Text="Write the hotkey as Ctrl+Alt+Space. Currently registered:" />
          <Run Text="{Binding RegisteredChord, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" />
          <Run Text="— a chord another application owns makes the launcher fall back to the next one." />
        </TextBlock>

        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Daily recap" />
        <Border Style="{StaticResource GroupStyle}">
          <StackPanel>
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Day starts at (hour, 0–12)" />
              <TextBox Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding RecapDayStartHour, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Earlier days to include (0–14)" />
              <TextBox Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding RecapLookbackDays, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="List my git commits" />
              <CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBoxStyle}" IsChecked="{Binding RecapIncludeGit}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Offer to summarize with Claude" />
              <CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBoxStyle}" IsChecked="{Binding RecapAiSummary}" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource CardCaptionStyle}"
                   Text="Work before the start hour counts toward the previous day. Earlier days are days with activity, so a weekend does not use them up. Summarizing sends the day's session titles, prompts and commit messages to Claude through your own claude command; nothing else in the app sends transcript text anywhere." />

        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Programs" />
        <Border Style="{StaticResource GroupStyle}">
          <StackPanel>
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Editor executable" />
              <TextBox Grid.Column="1" Style="{StaticResource FieldStyle}" Text="{Binding EditorPath, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Terminal executable" />
              <TextBox Grid.Column="1" Style="{StaticResource FieldStyle}" Text="{Binding TerminalPath, UpdateSourceTrigger=LostFocus}" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource CardCaptionStyle}"
                   Text="Leave blank to find Visual Studio Code in its usual places, and to prefer Windows Terminal over the command shell." />

        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Ranking" />
        <Border Style="{StaticResource GroupStyle}">
          <StackPanel>
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Maximum results" />
              <TextBox Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding MaxResults, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Recency weight" />
              <TextBox Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding RecencyWeight, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Recency half-life (days)" />
              <TextBox Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding RecencyHalfLifeDays, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Title weight" />
              <TextBox Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding TitleWeight, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Folder weight" />
              <TextBox Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding FolderWeight, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Resume prompt weight" />
              <TextBox Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding LastPromptWeight, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="User prompt weight" />
              <TextBox Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding UserPromptWeight, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Assistant text weight" />
              <TextBox Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding AssistantTextWeight, UpdateSourceTrigger=LostFocus}" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource CardCaptionStyle}"
                   Text="Recency weight is how much a session touched today outscores an equally relevant old one: 0.6 means 1.6 times." />

        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Locations" />
        <Border Style="{StaticResource GroupStyle}">
          <StackPanel>
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Settings file" Margin="0,0,16,0" />
              <TextBox Grid.Column="1" Style="{StaticResource PathStyle}" Text="{Binding SettingsFilePath, Mode=OneWay}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Index" Margin="0,0,16,0" />
              <TextBox Grid.Column="1" Style="{StaticResource PathStyle}" Text="{Binding IndexFilePath, Mode=OneWay}" />
            </Grid>
            <Border Style="{StaticResource RowSeparatorStyle}" />
            <Grid Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BodyTextStyle}" Text="Logs" Margin="0,0,16,0" />
              <TextBox Grid.Column="1" Style="{StaticResource PathStyle}" Text="{Binding LogFolderPath, Mode=OneWay}" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{Binding IndexPathNotice, Mode=OneWay}" />

      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="1"
               Margin="24,10,24,0"
               Foreground="{DynamicResource ErrorTextBrush}"
               FontSize="12"
               TextWrapping="Wrap"
               Text="{Binding ValidationMessage}"
               Visibility="{Binding ValidationMessage, Converter={StaticResource NullToCollapsed}}" />

    <Border Grid.Row="2" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="24,12,16,14" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Close" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseClicked" />
        <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
