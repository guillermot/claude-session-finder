<Window x:Class="SessionFinder.Wpf.Views.RecapWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily recap"
        Width="680"
        Height="640"
        MinWidth="480"
        MinHeight="380"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <Style x:Key="StepButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="FooterHintStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Text" Value="← → change day  ·  Enter copy  ·  Esc close" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status, TargetNullValue=''}" Value="">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="22,18,22,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="2,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Heading}"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subheading}"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="12"
                   Margin="0,3,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="‹" ToolTip="Previous active day (←)"
                Style="{StaticResource StepButtonStyle}"
                Command="{Binding PreviousDayCommand}" />
        <Button Content="›" ToolTip="Next active day (→)"
                Style="{StaticResource StepButtonStyle}"
                Command="{Binding NextDayCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Background="{StaticResource FieldSurfaceBrush}"
            BorderBrush="{StaticResource SurfaceEdgeBrush}"
            BorderThickness="1"
            CornerRadius="10">
      <ScrollViewer Style="{StaticResource OverlayScrollViewerStyle}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="22,16,22,20">
        <StackPanel x:Name="Document" />
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" Margin="2,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Text="{Binding Status}"
                 Foreground="{StaticResource AccentTextBrush}"
                 FontSize="11"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
      <TextBlock Grid.Column="0" Style="{StaticResource FooterHintStyle}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="{Binding ToggleViewText}"
                Focusable="False"
                Style="{StaticResource SecondaryButtonStyle}"
                Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibility}}"
                Command="{Binding ToggleViewCommand}" />
        <Button Content="✦ Summarize with Claude"
                Focusable="False"
                Style="{StaticResource SecondaryButtonStyle}"
                Visibility="{Binding CanSummarize, Converter={StaticResource BooleanToVisibility}}"
                Command="{Binding SummarizeCommand}" />
        <Button Content="Close"
                Focusable="False"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="OnCloseClicked" />
        <Button Content="Copy"
                Focusable="False"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding CopyCommand}" />
      </StackPanel>
    </Grid>

  </Grid>
</Window>
