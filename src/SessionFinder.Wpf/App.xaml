<Application x:Class="SessionFinder.Wpf.App"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SessionFinder.Wpf.Views">
  <!--
    No StartupUri: the window is created by the composition root and shown by the shell, because a
    launcher that is hidden most of the time must not put a window on screen when it starts.
  -->
  <Application.Resources>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <views:NullToCollapsedConverter x:Key="NullToCollapsed" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="SurfaceEdgeBrush" Color="#FF3A3D42" />
    <SolidColorBrush x:Key="FieldSurfaceBrush" Color="#FF17181A" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFECEDEE" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF9BA1A8" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF7FB2F0" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF2D4F7C" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFE0796C" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFE0A96C" />

    <!--
      The search box itself, and the greyed prompt drawn behind it while it is empty.

      The prompt is a sibling of the text box rather than anything the text box owns, because the
      text box owns the caret and the selection and a placeholder that is part of its content would
      be part of both. It is also not hit-testable, so a click anywhere over it lands on the box
      underneath and puts the caret where the user aimed.
    -->
    <Style x:Key="QueryBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="QueryPlaceholderStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
      The scroll bar of the results list.

      The default one is Win32 chrome: a light grey band the width of a finger with an arrow button
      at each end, none of which belongs in a borderless dark window that has no other chrome. What
      replaces it is drawn from the same palette as everything else — the thumb is the secondary
      text colour, faded, so it reads as part of the window rather than as a control bolted to it.

      The thumb is always drawn rather than faded in on hover. A launcher is on screen for two
      seconds at a time, and a scroll bar that only appears once the pointer has found it is a scroll
      bar that never tells the user there is more below the fold.
    -->
    <Style x:Key="OverlayScrollBarThumbStyle" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{StaticResource SecondaryTextBrush}"
                    Width="7"
                    CornerRadius="3.5"
                    HorizontalAlignment="Center"
                    SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      The halves of the track above and below the thumb. They are invisible but not absent: they are
      what turns a click on the track into a page up or a page down.
    -->
    <Style x:Key="OverlayScrollBarPageButtonStyle" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Rectangle Fill="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="OverlayScrollBarStyle" TargetType="ScrollBar">
      <Setter Property="Width" Value="11" />
      <Setter Property="MinWidth" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand"
                                Style="{StaticResource OverlayScrollBarPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="ScrollThumb"
                         Style="{StaticResource OverlayScrollBarThumbStyle}"
                         MinHeight="28"
                         Opacity="0.35" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand"
                                Style="{StaticResource OverlayScrollBarPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ScrollThumb" Property="Opacity" Value="0.6" />
              </Trigger>
              <Trigger SourceName="ScrollThumb" Property="Thumb.IsDragging" Value="True">
                <Setter TargetName="ScrollThumb" Property="Opacity" Value="0.9" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      The scroll bar is laid over the content rather than beside it, in the same cell of a one-cell
      grid. Beside it is what the stock template does, and it costs the width of the bar out of the
      rows the moment the list grows past its viewport: every row re-wraps and the ellipsis moves as
      the user types. Over it, the rows are the same width whether the list scrolls or not, and the
      thumb is narrower than the padding of a row, so it never lands on text.
    -->
    <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      CanContentScroll="{TemplateBinding CanContentScroll}"
                                      CanHorizontallyScroll="False"
                                      CanVerticallyScroll="False" />
              <ScrollBar x:Name="PART_VerticalScrollBar"
                         Orientation="Vertical"
                         HorizontalAlignment="Right"
                         Margin="0,2,1,2"
                         Style="{StaticResource OverlayScrollBarStyle}"
                         Minimum="0"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ResultRowStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Surface"
                    Background="Transparent"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SelectionBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      The keyboard focus ring.

      The stock one is a dotted black rectangle, which on a near-black window is a focus ring that
      cannot be seen. Removing it instead of replacing it would leave the settings window navigable
      by Tab but impossible to follow, so it is redrawn in the accent colour, outside the control it
      belongs to: it is painted in the adorner layer, so the negative margin puts it around the
      control rather than over its edge.
    -->
    <Style x:Key="AccentFocusVisualStyle">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3"
                       RadiusX="6"
                       RadiusY="6"
                       Stroke="{StaticResource AccentTextBrush}"
                       StrokeThickness="1"
                       SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      A text field on the settings form.

      Setting only the colours on the stock template is what produced the half-dark field in the
      first screenshots: the frame around it is drawn by the classic chrome, which ignores the
      border brush it was given and keeps its own light edge on focus. The template is replaced so
      the frame comes from the palette, and focus is shown by the accent edge rather than by a ring,
      because the field already has a border to colour.

      A read-only field is a path the form displays rather than a value it accepts, and it is drawn
      as one: the surface drops back to the window colour and the text to the secondary one.
    -->
    <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource FieldSurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Field"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource SecondaryTextBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Field" Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Field" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      A tick box on the settings form.

      The stock one is a white square with a hard border and a black tick, drawn by the same classic
      chrome as the scroll bar and just as out of place. The replacement is the field surface when
      it is off and the selection colour when it is on, so that "checked" is the same blue as a
      selected row in the search window rather than a third meaning for a fourth colour.
    -->
    <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box"
                      Width="16"
                      Height="16"
                      CornerRadius="4"
                      Background="{StaticResource FieldSurfaceBrush}"
                      BorderBrush="{StaticResource SurfaceEdgeBrush}"
                      BorderThickness="1"
                      VerticalAlignment="Center"
                      SnapsToDevicePixels="True">
                <Path x:Name="Tick"
                      Data="M 0,3.6 L 3.4,7 L 9,0.8"
                      Stroke="{StaticResource PrimaryTextBrush}"
                      StrokeThickness="1.7"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />
              </Border>
              <ContentPresenter Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource SelectionBrush}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      A button on the settings form.

      Hover and pressed are a translucent layer over the button rather than two more colours in the
      palette: the same template then works for the filled primary button and the outlined secondary
      one, and neither state needs a shade invented for it. Light lifts the surface on hover, the
      window colour presses it back down.
    -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="20,7" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Surface"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="5"
                      SnapsToDevicePixels="True" />
              <Border x:Name="StateLayer"
                      Background="{StaticResource PrimaryTextBrush}"
                      CornerRadius="5"
                      Opacity="0" />
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer" Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter TargetName="StateLayer" Property="Opacity" Value="0.4" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
    </Style>

  </Application.Resources>
</Application>
