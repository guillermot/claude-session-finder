<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Diagnostic head. Exists from day one so every milestone is verifiable without a UI,
    and so the engine can be smoke-tested on macOS before an Avalonia head exists.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SessionFinder.Cli</RootNamespace>
    <AssemblyName>finder</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SessionFinder.Core\SessionFinder.Core.csproj" />
    <ProjectReference Include="..\SessionFinder.Infrastructure\SessionFinder.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
